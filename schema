-- Run once against your Railway Postgres (Railway > Postgres > Data > Query, or psql).
CREATE TABLE IF NOT EXISTS leads (
    id              BIGSERIAL PRIMARY KEY,
    wa_id           TEXT NOT NULL,                 -- their WhatsApp number
    industry        TEXT,                          -- renovation / tuition / home_services
    business_name   TEXT,
    team_size       TEXT,
    monthly_volume  TEXT,
    biggest_leak    TEXT,
    booking_system  TEXT,
    consent         BOOLEAN,
    raw             JSONB NOT NULL,                -- full flow payload, nothing lost
    received_at     TIMESTAMPTZ NOT NULL DEFAULT now(),
    demo_sent_at    TIMESTAMPTZ,                   -- fill in when you send their demo
    paid            BOOLEAN NOT NULL DEFAULT false,-- fill in when Stripe payment matches
    notes           TEXT
);
CREATE INDEX IF NOT EXISTS leads_industry_idx ON leads (industry);
CREATE INDEX IF NOT EXISTS leads_wa_id_idx ON leads (wa_id);

